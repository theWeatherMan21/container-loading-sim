+// ═══════════════════════════════════════════
+// 3) P2-⑥：推荐提升文案（两种分支 + 静态契约）
+// ═══════════════════════════════════════════
+test('C3-PROMO-DIFF 提升值 ≠ 原推荐值 → 文案写原推荐箱型与原箱数（不复述新箱型）', () => {
+  const r = CDB.buildPromotionReasoning({
+    mode: 'single-box', newCode: '45HQ', prevCode: '40FR', prevCount: 3, totalItems: 6
+  });
+  assert(r.promoted === true, '箱型不同的情况应标记为提升');
+  assert(/优于原推荐 40FR（需 3 箱）/.test(r.reasoning), `应引用原推荐 40FR 与 3 箱，实际 ${r.reasoning}`);
+  assert(!/优于原推荐 45HQ/.test(r.reasoning), `不得出现“优于原推荐 45HQ”，实际 ${r.reasoning}`);
+  assert(/45HQ/.test(r.reasoning), '文案仍应说明新箱型');
+});
+
+test('C3-PROMO-SAME 提升值 = 原推荐值 → 只说“已验证”，绝不出现“X 优于原推荐 X”', () => {
+  const r = CDB.buildPromotionReasoning({
+    mode: 'single-box', newCode: '20FR', prevCode: '20FR', prevCount: 1, totalItems: 6
+  });
+  assert(r.promoted === false, '箱型相同不应标记提升');
+  assert(!/优于原推荐/.test(r.reasoning), `同箱型不得出现“优于原推荐”，实际 ${r.reasoning}`);
+  assert(/与原推荐一致/.test(r.reasoning), `应说明与原推荐一致，实际 ${r.reasoning}`);
+
+  // fewer-boxes 模式同箱型（箱数相同本该无文案，防御性覆盖）
+  const r2 = CDB.buildPromotionReasoning({
+    mode: 'fewer-boxes', newCode: '40HQ', newCount: 2, prevCode: '40HQ', prevCount: 2
+  });
+  assert(!/优于原推荐/.test(r2.reasoning), `同箱型不得出现“优于原推荐”，实际 ${r2.reasoning}`);
+});
+
+test('C3-PROMO-SRC 源码静态契约：提升文案统一走纯函数，原推荐值取覆盖前', () => {
+  const src = fs.readFileSync(path.join(__dirname, '..', 'app.js'), 'utf8');
+  assert(/CDB\.buildPromotionReasoning\(/.test(src), 'app.js 应调用 CDB.buildPromotionReasoning');
+  assert(!/优于原推荐 \$\{recommendation\.primary\.code\}/.test(src),
+    '文案模板不应直接读 recommendation.primary.code（覆盖后=新箱型）');
+  assert(!/优于原推荐 \$\{/.test(src), 'app.js 内不应再内联拼“优于原推荐”模板（统一走纯函数）');
+  const calls = (src.match(/CDB\.buildPromotionReasoning\(/g) || []).length;
+  assert(calls === 2, `两处提升分支都应走纯函数，实际 ${calls} 处`);
+});
