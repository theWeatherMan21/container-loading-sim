@@ -0,0 +1,201 @@
+// scripts/test-regressions-c3.js — C3 轮（2026-10-15 复审遗留清理）回归固化
+// 覆盖：① P1-6 空间充足却漏装 → 未装件重排重试 pass（严格改进、绝不劣化）
+//       ② P2-① 45HQ 纳入单件分类（超长货不再被误推更贵的 FR）+ 分类/推荐/引擎三方一致
+//       ③ P2-⑥ 推荐提升文案 "X 优于原推荐 X"（纯函数两种分支 + 源码静态契约）
+//       ④ P1-8 超长货分类与引擎装载一致性回归（C2 已隐式修复，此处固化防回退）
+//       ⑤ P2-4 selfCheck 越界口径与放置路径统一（±5cm 宽口径修正）
+// 用法：node scripts/test-regressions-c3.js（或由 test-all.js 聚合运行）
+const path = require('path');
+const fs = require('fs');
+const { createRuntime } = require('./_load-runtime');
+
+const ctx = createRuntime(['container-db.js', 'planner.js', 'packing-engine.js']);
+const CDB = ctx.window.ContainerDB;
+const PE = ctx.window.PackingEngine;
+
+let passed = 0;
+let failed = 0;
+let assertCount = 0;
+
+function assert(condition, message) {
+  assertCount++;
+  if (!condition) throw new Error(message);
+}
+
+function test(name, fn) {
+  try {
+    fn();
+    passed++;
+    console.log(`PASS ${name}`);
+  } catch (error) {
+    failed++;
+    console.error(`FAIL ${name}: ${error.message}`);
+    process.exitCode = 1;
+  }
+}
+
+// ═══════════════════════════════════════════
+// 1) P1-6：未装件重排重试 pass（空间充足却漏装）
+// ═══════════════════════════════════════════
+test('C3-P16-RETRY 小件铺满地面后大件不再漏装（重试 pass 严格改进）', () => {
+  const gp20 = CDB.CONTAINER_DB['20GP'];
+  const small = Array.from({ length: 60 }, () => ({
+    model: 'SMALL', l: 0.4, w: 0.4, h: 0.4, weight: 20, stackable: true, quantity: 1
+  }));
+  const big = [{ model: 'BIG', l: 1.2, w: 1.2, h: 1.0, weight: 500, stackable: false, quantity: 1 }];
+  const items = [...small, ...big];
+
+  // 单遍（重试 pass 关掉）= 修复前行为：历史 60/61，大件漏装
+  const singlePass = PE.packSingleContainer(items, gp20, { tolerance: 0.05, sortStrategy: 'smart', _retryPass: true });
+  assert(singlePass.placedItems.length === 60, `单遍应复现 60/61 漏装，实际 ${singlePass.placedItems.length}`);
+  assert(!singlePass.placedItems.some(p => p.model === 'BIG'), '单遍应漏掉大件（复现前提）');
+
+  // 默认（带重试 pass）→ 61/61
+  const r = PE.packSingleContainer(items, gp20, { tolerance: 0.05, sortStrategy: 'smart' });
+  assert(r.placedItems.length === 61, `重试后应装入 61/61，实际 ${r.placedItems.length}`);
+  assert(r.unplacedItems.length === 0, `重试后不应有未装件，实际 ${r.unplacedItems.length}`);
+  assert(r.recoveredByRetry === true, '应从重试 pass 采纳结果（recoveredByRetry 标记）');
+
+  // 端到端单箱
+  const e2e = PE.calculate(items, '20GP', { tolerance: 0.05 });
+  assert(e2e.totalPlaced === 61 && e2e.unplacedCount === 0, `端到端应全装，实际 ${e2e.totalPlaced}/${e2e.unplacedCount}`);
+  assert(e2e.containerCount === 1, `应 1 箱，实际 ${e2e.containerCount}`);
+});
+
+test('C3-P16-NODEGRADE 重试不劣化：真装不下的货仍保持未装且计数不减少', () => {
+  const gp20 = CDB.CONTAINER_DB['20GP'];
+  const small = Array.from({ length: 60 }, () => ({
+    model: 'SMALL', l: 0.4, w: 0.4, h: 0.4, weight: 20, stackable: true, quantity: 1
+  }));
+  const big = { model: 'BIG', l: 1.2, w: 1.2, h: 1.0, weight: 500, stackable: false, quantity: 1 };
+  const giant = { model: 'GIANT', l: 3.0, w: 3.0, h: 3.0, weight: 2000, stackable: false, quantity: 1 }; // 20GP 物理放不下
+  const r = PE.packSingleContainer([...small, big, giant], gp20, { tolerance: 0.05, sortStrategy: 'smart' });
+  assert(r.placedItems.length === 61, `应装入 61 件（60 小 + 1 大），实际 ${r.placedItems.length}`);
+  assert(r.unplacedItems.length === 1 && r.unplacedItems[0].model === 'GIANT',
+    `仅 GIANT 应保持未装，实际 ${JSON.stringify(r.unplacedItems.map(u => u.model))}`);
+});
+
+// ═══════════════════════════════════════════
+// 2) P2-①：45HQ 纳入单件分类
+// ═══════════════════════════════════════════
+test('C3-45HQ-CLASS 超长货（>40HQ 内长、≤45HQ 内长）应分类 45HQ，不再误判 FR', () => {
+  const hq40 = CDB.CONTAINER_DB['40HQ'];
+  const hq45 = CDB.CONTAINER_DB['45HQ'];
+  const len = 12.5; // 40HQ 内长 12.032 / 45HQ 内长 13.556
+  assert(len > hq40.L && len <= hq45.L, '用例前提：长度应落在 40HQ 与 45HQ 之间');
+  const item = { model: 'BRIDGE', l: len, w: 0.6, h: 0.8, weight: 4800, quantity: 1 };
+  assert(CDB.classifyItemByContainerType({ ...item }) === '45HQ',
+    `12.5m 应分类 45HQ，实际 ${CDB.classifyItemByContainerType({ ...item })}`);
+});
+
+test('C3-45HQ-REC 推荐成本比较：45HQ 可装 → 推荐 45HQ（不推更贵的 40FR）', () => {
+  const item = { model: 'BRIDGE', l: 12.5, w: 0.6, h: 0.8, weight: 4800, quantity: 1 };
+  const rec = CDB.autoRecommend([{ ...item }], 0.05);
+  assert(rec.type === 'single' && rec.primary && rec.primary.code === '45HQ',
+    `12.5m 应推荐 45HQ，实际 ${rec.type}/${rec.primary && rec.primary.code}`);
+  assert(/45HQ/.test(rec.reasoning || '') && /40FR|框架柜/.test(rec.reasoning || ''),
+    `推荐理由应说明 45HQ 优于框架柜，实际 ${rec.reasoning}`);
+  // 引擎必须真能单箱装下（分类/推荐/引擎三方一致的前提）
+  const r = PE.calculate([{ ...item }], '45HQ', { tolerance: 0.05 });
+  assert(r.totalPlaced === 1 && r.containerCount === 1, `45HQ 应单箱装入 12.5m 货，实际 ${r.totalPlaced}`);
+});
+
+test('C3-45HQ-BOUNDARY 边界：13.556m 以上回退 FR；14m 仍不可装', () => {
+  // 13.556m = 45HQ 内长 → 进 FR 分支（40FR 贴端伸出）
+  const over45 = { model: 'B13.6', l: 13.6, w: 0.6, h: 0.8, weight: 4800, quantity: 1 };
+  assert(CDB.classifyItemByContainerType({ ...over45 }) === 'FR',
+    `13.6m 应分类 FR，实际 ${CDB.classifyItemByContainerType({ ...over45 })}`);
+  const recOver45 = CDB.autoRecommend([{ ...over45 }], 0.05);
+  assert(recOver45.primary && recOver45.primary.code === '40FR',
+    `13.6m 应推荐 40FR，实际 ${recOver45.primary && recOver45.primary.code}`);
+
+  // 45HQ 能装但单件超 45HQ 载重（27.8t）→ 应回退框架柜，不得给出装不进的 45HQ
+  const heavy = { model: 'H30', l: 12.5, w: 0.6, h: 0.8, weight: 30000, quantity: 1 };
+  assert(CDB.classifyItemByContainerType({ ...heavy }) === '45HQ', '30t 12.5m 货形状上属 45HQ 档');
+  const recHeavy = CDB.autoRecommend([{ ...heavy }], 0.05);
+  assert(recHeavy.primary && recHeavy.primary.code === '40FR',
+    `30t 超 45HQ 载重应回退 40FR，实际 ${recHeavy.primary && recHeavy.primary.code}`);
+  const rHeavy = PE.calculate([{ ...heavy }], '40FR', { tolerance: 0.05 });
+  assert(rHeavy.totalPlaced === 1, `40FR 应能装 30t 12.5m 货，实际 ${rHeavy.totalPlaced}`);
+});
